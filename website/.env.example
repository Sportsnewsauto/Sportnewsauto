# Supabase project settings (Connect -> Framework -> Next.js or Project Settings -> API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional legacy anon key variable; publishable key is preferred.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Backend-only secrets. Never use NEXT_PUBLIC_ for these.
DATABASE_URL=
SESSION_SECRET=
CREDENTIAL_ENCRYPTION_KEY=
APP_BASE_URL=http://localhost:3000

# Payment integration will be added later.
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# Server-only GitHub App credentials for immediate manual worker starts.
# The GitHub App must be installed on this repository with Actions: write permission.
# Keep the private key out of source control and browser-visible variables.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_REPOSITORY=Sportsnewsauto/Sportnewsauto
GITHUB_DEFAULT_BRANCH=main
