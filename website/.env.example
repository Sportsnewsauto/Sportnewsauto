# Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional legacy anon key variable; publishable key is preferred.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Backend-only secrets. Never use NEXT_PUBLIC_ for these.
DATABASE_URL=
SESSION_SECRET=
CREDENTIAL_ENCRYPTION_KEY=

# Canonical production address on Cloudflare Workers.
APP_BASE_URL=https://sportnewsauto.kingsleyke.workers.dev
SPREAKER_REDIRECT_URI=https://sportnewsauto.kingsleyke.workers.dev/api/integrations/spreaker/callback

# Supabase server-only key for the private payment ledger. Never expose with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Safaricom Daraja (start with sandbox; switch MPESA_ENV to production only
# after the live shortcode, passkey, Consumer Key and Consumer Secret are approved).
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_CALLBACK_TOKEN=

# Flutterwave V4 live collection API (server-only; never use NEXT_PUBLIC_).
# OAuth credentials from Settings > Developers > API Keys > V4 Live API keys.
FLUTTERWAVE_CLIENT_ID=
FLUTTERWAVE_CLIENT_SECRET=
# Use the same randomly generated value in Flutterwave Dashboard > Settings > Webhooks.
FLUTTERWAVE_WEBHOOK_HASH=

# Server-only GitHub App credentials for immediate manual worker starts.
# The GitHub App must be installed on this repository with Actions: write permission.
# Keep the private key out of source control and browser-visible variables.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_REPOSITORY=Sportsnewsauto/Sportnewsauto
GITHUB_DEFAULT_BRANCH=main
